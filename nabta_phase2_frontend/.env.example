# Developer/build configuration only. Do not expose backend URL editing to customers.
# Browser on the same computer as the backend:
VITE_NABTA_API_BASE=http://localhost:8080/api

# Android Studio emulator example (uncomment for emulator development):
# VITE_NABTA_API_BASE=http://10.0.2.2:8080/api

# Physical Android phone example (replace with the development computer LAN IP):
# VITE_NABTA_API_BASE=http://192.168.1.20:8080/api

# Production should use the single deployed HTTPS API endpoint, for example:
# VITE_NABTA_API_BASE=https://api.example.com/api
